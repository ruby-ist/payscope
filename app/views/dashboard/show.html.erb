<h1 class="mb-4 text-2xl font-semibold text-nav-bg">Dashboard</h1>

<div class="rounded-md border border-border bg-surface p-4">
  <div>
    <%= render "dashboard/controls", group_by: @group_by, aggregation: @aggregation, from: @from, to: @to %>
  </div>

  <div class="mt-6">
    <%= render "dashboard/chart", chart_config: @chart_config, group_by: @group_by, aggregation: @aggregation %>
  </div>
</div>
