<div id="flash">
  <% if notice.present? %>
    <p id="notice" class="mb-4 flex items-center gap-2 rounded-md border border-primary bg-surface px-4 py-3 text-sm text-text">
      <%= icon "check", css_class: "size-4 shrink-0 text-primary" %>
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p id="alert" class="mb-4 flex items-center gap-2 rounded-md border border-destructive bg-surface px-4 py-3 text-sm text-destructive">
      <%= icon "x" %>
      <%= alert %>
    </p>
  <% end %>
</div>
