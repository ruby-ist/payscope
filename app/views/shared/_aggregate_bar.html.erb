<%
  currency = local_assigns[:currency] || "USD"
  cards = [
    { label: "Min", value: aggregated_amount(summary[:min], currency: currency) },
    { label: "Max", value: aggregated_amount(summary[:max], currency: currency) },
    { label: "Avg", value: aggregated_amount(summary[:avg], currency: currency) },
    { label: "Sum", value: aggregated_amount(summary[:sum], currency: currency) },
    { label: "Count", value: number_with_delimiter(summary[:count]), showing: page_showing(pagy) },
  ]
%>

<div data-aggregate-bar class="mb-4 grid grid-cols-2 gap-2 md:flex">
  <% cards.each do |card| %>
    <div class="<%= "col-span-2 mx-auto w-1/2 md:col-span-1 md:mx-0 md:w-auto" if card == cards.last %>
                rounded-md border border-border bg-surface px-3 py-2 md:min-w-32 md:flex-1 md:shrink-0">
      <p class="text-sm uppercase tracking-wide text-text-muted"><%= card[:label] %></p>
      <p class="numeric py-4"><%= card[:value] %></p>

      <% if card.key?(:showing) %>
        <p class="text-xs text-text-muted" data-controller="page-range"
           data-action="turbo:frame-load@document->page-range#update"><%= card[:showing] %></p>
      <% end %>
    </div>
  <% end %>
</div>
