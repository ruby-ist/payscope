<%= turbo_stream.replace "flash", partial: "shared/flash" %>

<% if @exchange_rate.persisted? %>
  <%= turbo_stream.append "exchange_rates" do %>
    <%= turbo_frame_tag dom_id(@exchange_rate) do %>
      <%= render @exchange_rate %>
    <% end %>
  <% end %>
  <%= turbo_stream.replace "new_exchange_rate" do %>
    <%= turbo_frame_tag "new_exchange_rate" do %>
      <%= render "form", exchange_rate: ExchangeRate.new %>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "new_exchange_rate" do %>
    <%= turbo_frame_tag "new_exchange_rate" do %>
      <%= render "form", exchange_rate: @exchange_rate %>
    <% end %>
  <% end %>
<% end %>
