<%= turbo_stream.replace "flash", partial: "shared/flash" %>

<% if @exchange_rate.errors.empty? %>
  <%= turbo_stream.replace dom_id(@exchange_rate) do %>
    <%= turbo_frame_tag dom_id(@exchange_rate) do %>
      <%= render @exchange_rate %>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@exchange_rate) do %>
    <%= turbo_frame_tag dom_id(@exchange_rate) do %>
      <%= render "form", exchange_rate: @exchange_rate %>
    <% end %>
  <% end %>
<% end %>
