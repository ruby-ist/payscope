<h1>Exchange Rates</h1>

<ul id="exchange_rates">
  <% @exchange_rates.each do |exchange_rate| %>
    <%= turbo_frame_tag dom_id(exchange_rate) do %>
      <% if exchange_rate == @editing_exchange_rate %>
        <%= render "form", exchange_rate: @editing_exchange_rate %>
      <% else %>
        <%= render exchange_rate %>
      <% end %>
    <% end %>
  <% end %>
</ul>

<%= turbo_frame_tag "new_exchange_rate" do %>
  <%= render "form", exchange_rate: @new_exchange_rate %>
<% end %>
