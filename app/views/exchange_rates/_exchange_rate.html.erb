<div class="rate-row text-sm">
  <p class="rate-equation" data-controller="rate-calculator"
     data-rate-calculator-rate-value="<%= exchange_rate.rate %>">
    <%= number_field_tag "amount", 1, id: dom_id(exchange_rate, "amount"), min: 0, step: "any", inputmode: "decimal",
                         autocomplete: "off", class: "field numeric w-full", aria: { label: "Amount to convert" },
                         data: { rate_calculator_target: "amount", action: "input->rate-calculator#calculate" } %>
    <span class="rate-value numeric"><%= exchange_rate.currency %></span>
    <span class="text-text-muted mx-6">=</span>
    <span class="rate-value numeric overflow-x-auto whitespace-nowrap" data-rate-calculator-target="result"><%= formatted_rate(exchange_rate) %></span>
    <span class="numeric text-text-muted">USD</span>
  </p>

  <div class="flex flex-1 justify-center">
    <%= last_synced_label(exchange_rate) %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to edit_exchange_rate_path(exchange_rate), class: "btn-neutral" do %>
      <%= icon_label "pencil", "Edit" %>
    <% end %>

    <%= button_to exchange_rate_path(exchange_rate), method: :delete, class: "btn-destructive",
                  form: { class: "inline-block" },
                  data: { turbo_confirm: "Are you sure you want to delete this exchange rate?" } do %>
      <%= icon_label "trash_2", "Delete" %>
    <% end %>
  </div>
</div>
