<div data-controller="drawer">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-nav-bg">Employees</h1>

    <div class="flex flex-wrap items-center gap-2">
      <% if @sidebar_data_loaded %>
        <button type="button" class="btn-neutral md:hidden" data-action="drawer#open">
          <%= icon_label "sliders_horizontal", "Filter" %>
        </button>

        <div class="flex items-center gap-2" data-controller="sort"
             data-sort-ascending-label-value="Sorted ascending — press to sort descending"
             data-sort-descending-label-value="Sorted descending — press to sort ascending">
          <%= label_tag :sort_by, "Sort by", class: "whitespace-nowrap text-sm text-text-muted" %>

          <div class="flex items-stretch">
            <%= select_tag :sort_by, options_for_select(sort_by_options, sort_column),
                           form: "employee_filters", class: "field rounded-r-none border-r-0",
                           data: { sort_target: "column", action: "change->sort#submit" } %>

            <%= hidden_field_tag :sort_dir, sort_direction, form: "employee_filters",
                                 data: { sort_target: "direction" } %>

            <button type="button" class="btn-neutral rounded-l-none" data-action="sort#toggle"
                    data-sort-target="toggle"
                    title="<%= sort_direction == 'asc' ? 'Sorted ascending — press to sort descending' : 'Sorted descending — press to sort ascending' %>"
                    aria-label="<%= sort_direction == 'asc' ? 'Sorted ascending — press to sort descending' : 'Sorted descending — press to sort ascending' %>">
              <% Employee::SortService::DIRECTIONS.each do |direction| %>
                <%= tag.span icon(direction == "asc" ? "arrow_up_narrow_wide" : "arrow_down_wide_narrow"),
                             class: ("hidden" unless direction == sort_direction),
                             data: { sort_target: "#{direction}Icon" } %>
              <% end %>
            </button>
          </div>
        </div>

        <%# A real `disabled` attribute blocks hover entirely in most browsers, so
            the title/aria-label tooltip would never show. aria-disabled keeps it
            focusable and hoverable while still doing nothing on click (it has no
            href or action), and hover:bg-primary cancels btn-primary's own hover
            fill so it doesn't look interactive. %>
        <% if @exchange_rates.none? %>
          <button type="button" aria-disabled="true" title="Create an exchange rate first"
                  aria-label="Create an exchange rate first"
                  class="btn-primary cursor-not-allowed opacity-50 hover:bg-primary">
            <%= icon_label "plus_circle", "New employee" %>
          </button>
        <% else %>
          <%= link_to new_employee_path, class: "btn-primary" do %>
            <%= icon_label "plus_circle", "New employee" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Everything keyed off @sidebar_data_loaded sits outside the employee_list
      frame, so paging neither re-queries nor re-renders it. %>
  <%= render "results_frame" %>

  <% if @sidebar_data_loaded %>
    <div data-drawer-target="panel" class="hidden md:hidden">
      <div class="fixed inset-0 z-40 bg-text/40" data-action="click->drawer#close"></div>

      <div class="fixed inset-y-0 left-0 z-50 flex w-88 max-w-[calc(100vw-3rem)] flex-col border-r border-border bg-surface">
        <div class="flex items-center justify-between border-b border-border px-4 py-3">
          <h2 class="text-lg font-semibold text-nav-bg">Filters</h2>
          <button type="button" class="btn-neutral" data-action="drawer#close">
            <%= icon_label "x", "Close" %>
          </button>
        </div>

        <div class="flex-1 overflow-y-auto px-4 py-4">
          <%= render "employees/filters", form_id: "employee_filters_drawer", exchange_rates: @exchange_rates, sort_field: true %>
        </div>
      </div>
    </div>
  <% end %>
</div>
