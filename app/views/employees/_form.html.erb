<%= form_with model: employee, class: "max-w-2xl rounded-md border border-border bg-surface p-6" do |form| %>
  <div class="grid gap-5 sm:grid-cols-2">
    <%= render "shared/field", form: form, attribute: :employee_code, label: "Employee code",
                               width_class: "w-[10ch]", autocomplete: "off" %>
    <%= render "shared/field", form: form, attribute: :full_name, label: "Full name", width_class: "w-[28ch] max-w-full" %>
    <%= render "shared/field", form: form, attribute: :job_title, label: "Job title", width_class: "w-[28ch] max-w-full" %>
    <%= render "shared/field", form: form, attribute: :department, label: "Department", width_class: "w-[20ch] max-w-full" %>
    <%= render "shared/field", form: form, attribute: :country, label: "Country", width_class: "w-[20ch] max-w-full" %>

    <%# Salary and its currency read as a single control: shared border, no gap (§8). %>
    <%
      salary_errors = employee.errors[:local_salary]
      currency_errors = employee.errors[:exchange_rate]
      joined_errors = salary_errors + currency_errors
    %>
    <div class="sm:col-span-2">
      <div class="mb-1 flex flex-wrap items-baseline gap-x-2">
        <%= form.label :local_salary, "Salary", class: "text-sm text-text-muted" %>

        <% if joined_errors.any? %>
          <span id="employee_salary_error" class="text-xs text-destructive"><%= joined_errors.first %></span>
        <% end %>
      </div>

      <div class="flex w-fit items-stretch">
        <%= form.number_field :local_salary, step: 0.01,
                              class: class_names("field numeric w-[14ch] rounded-r-none border-r-0", "field-error" => salary_errors.any?),
                              aria: { invalid: salary_errors.any?.presence,
                                      describedby: ("employee_salary_error" if joined_errors.any?) } %>

        <%= form.collection_select :exchange_rate_id, ExchangeRate.all, :id, :currency, {},
                                   class: class_names("field rounded-l-none", "field-error" => currency_errors.any?),
                                   aria: { invalid: currency_errors.any?.presence } %>
      </div>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2">
    <%= form.button type: :submit, class: "btn-primary" do %>
      <%= icon_label "check", "Save" %>
    <% end %>

    <%= link_to employees_path, class: "btn-neutral" do %>
      <%= icon_label "x", "Cancel" %>
    <% end %>
  </div>
<% end %>
